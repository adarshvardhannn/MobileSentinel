<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Main row (always visible) -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layoutMainRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp">

            <!-- App Icon -->
            <ImageView
                android:id="@+id/ivAppIcon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@string/app_icon_desc"
                android:scaleType="centerCrop"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:src="@mipmap/ic_launcher" />

            <!-- App Name -->
            <TextView
                android:id="@+id/tvAppName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="8dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#212121"
                android:textSize="15sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toStartOf="@id/tvFlaggedTag"
                app:layout_constraintStart_toEndOf="@id/ivAppIcon"
                app:layout_constraintTop_toTopOf="@id/ivAppIcon"
                tools:text="Google Chrome" />

            <!-- Package Name -->
            <TextView
                android:id="@+id/tvPackageName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginTop="2dp"
                android:layout_marginEnd="8dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#888888"
                android:textSize="11sp"
                app:layout_constraintEnd_toStartOf="@id/tvFlaggedTag"
                app:layout_constraintStart_toEndOf="@id/ivAppIcon"
                app:layout_constraintTop_toBottomOf="@id/tvAppName"
                tools:text="com.android.chrome" />

            <!-- Flagged Tag -->
            <TextView
                android:id="@+id/tvFlaggedTag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_risky_badge"
                android:paddingStart="8dp"
                android:paddingTop="3dp"
                android:paddingEnd="8dp"
                android:paddingBottom="3dp"
                android:text="@string/flagged_label"
                android:textColor="@android:color/white"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:visibility="visible" />

            <!-- Badges row -->
            <LinearLayout
                android:id="@+id/layoutBadges"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginTop="6dp"
                android:orientation="horizontal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/ivAppIcon"
                app:layout_constraintTop_toBottomOf="@id/tvPackageName">

                <!-- Memory Badge -->
                <TextView
                    android:id="@+id/tvMemoryBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip"
                    android:paddingStart="8dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="2dp"
                    android:textColor="#1565C0"
                    android:textSize="11sp"
                    tools:text="24 MB" />

                <!-- Dangerous Perm Count Badge -->
                <TextView
                    android:id="@+id/tvDangerousCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:paddingStart="8dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="2dp"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    tools:text="4 perms" />

                <!-- Expand indicator -->
                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <ImageView
                    android:id="@+id/ivExpandArrow"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center_vertical"
                    android:contentDescription="@string/expand_desc"
                    android:rotation="0"
                    android:src="@android:drawable/arrow_down_float" />

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Expandable Section -->
        <LinearLayout
            android:id="@+id/layoutExpanded"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="62dp"
            android:paddingEnd="12dp"
            android:paddingBottom="12dp"
            android:visibility="gone"
            tools:visibility="visible">

            <!-- Flag Reasons -->
            <TextView
                android:id="@+id/tvFlagReasonsHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/flag_reasons_header"
                android:textColor="#C62828"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvFlagReasons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#D32F2F"
                android:textSize="12sp"
                android:visibility="gone"
                tools:text="• 3+ dangerous permissions\n• Unknown install source" />

            <!-- Dangerous Permissions -->
            <TextView
                android:id="@+id/tvDangerousPermsHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/dangerous_perms_header"
                android:textColor="#E65100"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDangerousPerms"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#666666"
                android:textSize="11sp"
                tools:text="• CAMERA\n• ACCESS_FINE_LOCATION\n• READ_CONTACTS" />

            <!-- Install Source -->
            <TextView
                android:id="@+id/tvInstallSource"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="#666666"
                android:textSize="11sp"
                tools:text="Install source: com.android.vending" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>

